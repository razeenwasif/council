#!/usr/bin/env node

/**
 * Council — four-member AI council on top of OpenClaude's coordinator mode.
 *
 * If dist/cli.mjs exists (built), run that.
 * Otherwise, tell the user to build first or use `bun run dev`.
 *
 * Council mode is enabled at startup by setting CLAUDE_CODE_COORDINATOR_MODE
 * and CLAUDE_CODE_COUNCIL_MODE before the bundle loads — the agent registry
 * (getAgentDefinitionsWithOverrides in loadAgentsDir.ts) is memoized at first
 * read, so flipping these env vars from a slash command at runtime is too
 * late. To run a non-council session, set COUNCIL_OFF=1 in the environment.
 */

import { existsSync } from 'fs'
import { join, dirname } from 'path'
import { fileURLToPath, pathToFileURL } from 'url'

// ─── Heap-ceiling guard ─────────────────────────────────────────────────
// Long /discover-sweep runs accumulate UI state (REPL scrollback, agent
// thoughts pane, telemetry buffers) and OOM at v8's auto-tuned ~4 GB
// after ~3 h of sustained use. Bump to 16 GB by re-exec'ing with
// --max-old-space-size if we weren't launched with enough heap.
// Self-bootstrapping so plain `./bin/council` keeps working.
//
// Cause is a real leak (tracked in BACKLOG); this just buys headroom
// while the diagnostic work happens. Override via COUNCIL_HEAP_MB env
// (e.g. COUNCIL_HEAP_MB=8192 if the machine has < 32 GB free).
const HEAP_MB_TARGET = parseInt(process.env.COUNCIL_HEAP_MB ?? '16384', 10)
if (!process.env.COUNCIL_HEAP_BUMPED) {
  const v8 = await import('v8')
  const currentMB = Math.floor(v8.getHeapStatistics().heap_size_limit / 1024 / 1024)
  if (currentMB < HEAP_MB_TARGET) {
    const { spawn } = await import('child_process')
    const child = spawn(
      process.execPath,
      [`--max-old-space-size=${HEAP_MB_TARGET}`, ...process.argv.slice(1)],
      { stdio: 'inherit', env: { ...process.env, COUNCIL_HEAP_BUMPED: '1' } },
    )
    // Forward common termination signals so Ctrl+C in the TUI propagates.
    for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
      process.on(sig, () => { try { child.kill(sig) } catch {} })
    }
    child.on('exit', (code, sig) => {
      if (sig) process.kill(process.pid, sig)
      else process.exit(code ?? 0)
    })
    // Parent halts here — child runs the real Council.
    await new Promise(() => {})
  }
}

if (!process.env.COUNCIL_OFF) {
  process.env.CLAUDE_CODE_COORDINATOR_MODE = '1'
  process.env.CLAUDE_CODE_COUNCIL_MODE = '1'
}

// Most modern terminals (Windows Terminal, kitty, Alacritty, iTerm2,
// WezTerm, Ghostty) support 24-bit truecolor but don't always set
// COLORTERM. Without it, chalk downgrades RGB to the nearest 256-color
// palette slot — dark colors with subtle tints (e.g. our orange-themed
// dark bgs) snap to flat gray. Default to truecolor unless explicitly
// overridden (e.g. COLORTERM=8bit for old terminals).
process.env.COLORTERM = process.env.COLORTERM ?? 'truecolor'

// Default to alt-screen "flicker-free" mode — Council takes over the
// terminal like nvim/yazi/less, hiding shell scrollback while running
// and restoring it on exit. Without this, Council renders inline in
// the existing shell buffer.
// Set CLAUDE_CODE_NO_FLICKER=0 to revert to inline rendering.
// Auto-disabled under tmux -CC regardless (see src/utils/fullscreen.ts).
process.env.CLAUDE_CODE_NO_FLICKER = process.env.CLAUDE_CODE_NO_FLICKER ?? '1'

// Force synchronous agent dispatch — required by the deterministic
// orchestrator (default as of v1.x). Coordinator mode (just set above)
// would otherwise route every AgentTool.call into the background-task
// path: the call returns `{ status: "async_launched", agentId }`
// immediately, before the agent has actually produced any result. The
// deterministic orchestrator just awaits the promise; sync dispatch
// makes AgentTool.call resolve with the real result.
//
// This must be set BEFORE the bundle loads — the flag is captured at
// module load time in AgentTool.tsx as a top-level const.
//
// Parallelism is preserved: runCouncil still uses Promise.all to fan out
// the seven spawns concurrently. We're only changing the per-call return
// shape, not the orchestration model.
//
// Escape hatch: COUNCIL_LLM_COORDINATOR=1 opts back into the old LLM-
// coordinator path, which needs async dispatch (task-notification flow).
// Don't force sync in that case.
if (!process.env.COUNCIL_OFF && process.env.COUNCIL_LLM_COORDINATOR !== '1') {
  process.env.CLAUDE_CODE_DISABLE_BACKGROUND_TASKS = '1'
}

const __dirname = dirname(fileURLToPath(import.meta.url))
const distPath = join(__dirname, '..', 'dist', 'cli.mjs')

if (existsSync(distPath)) {
  await import(pathToFileURL(distPath).href)
} else {
  console.error(`
  council: dist/cli.mjs not found.

  Build first:
    bun run build

  Or run directly with Bun:
    bun run dev

  See README.md and COUNCIL.md for setup instructions.
`)
  process.exit(1)
}
